{
  "$ref": "#/definitions/DocumentRules",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ColourSpec": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "b": {
              "type": "number"
            },
            "g": {
              "type": "number"
            },
            "r": {
              "type": "number"
            },
            "type": {
              "const": "rgb",
              "type": "string"
            }
          },
          "required": [
            "type",
            "r",
            "g",
            "b"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "c": {
              "type": "number"
            },
            "k": {
              "type": "number"
            },
            "m": {
              "type": "number"
            },
            "type": {
              "const": "cmyk",
              "type": "string"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "c",
            "m",
            "y",
            "k"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "grey": {
              "type": "number"
            },
            "type": {
              "const": "grey",
              "type": "string"
            }
          },
          "required": [
            "type",
            "grey"
          ],
          "type": "object"
        }
      ]
    },
    "DefaultTextStyle": {
      "additionalProperties": false,
      "properties": {
        "colour": {
          "$ref": "#/definitions/ColourSpec"
        },
        "fontName": {
          "type": "string"
        },
        "fontSize": {
          "type": "number"
        },
        "lineHeight": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "DocumentMeta": {
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "$ref": "#/definitions/DefaultTextStyle"
        },
        "fonts": {
          "additionalProperties": {
            "$ref": "#/definitions/FontDefinition"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "DocumentRules": {
      "additionalProperties": false,
      "properties": {
        "documentMeta": {
          "$ref": "#/definitions/DocumentMeta"
        },
        "processingRules": {
          "items": {
            "$ref": "#/definitions/ProcessingRule"
          },
          "type": "array"
        }
      },
      "required": [
        "documentMeta",
        "processingRules"
      ],
      "type": "object"
    },
    "FontDefinition": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "standard",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "const": "custom",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "ImageElement": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "type": "number"
        },
        "path": {
          "type": "string"
        },
        "width": {
          "type": "number"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "PageSelector": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "all",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "pages": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": {
              "const": "specific",
              "type": "string"
            }
          },
          "required": [
            "type",
            "pages"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "first",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "last",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            },
            "type": {
              "const": "range",
              "type": "string"
            }
          },
          "required": [
            "type",
            "from",
            "to"
          ],
          "type": "object"
        }
      ]
    },
    "PositionSelector": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "ProcessingRule": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "element": {
              "$ref": "#/definitions/TextElement"
            },
            "page": {
              "$ref": "#/definitions/PageSelector"
            },
            "position": {
              "$ref": "#/definitions/PositionSelector"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "position",
            "element",
            "page"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "element": {
              "$ref": "#/definitions/ImageElement"
            },
            "page": {
              "$ref": "#/definitions/PageSelector"
            },
            "position": {
              "$ref": "#/definitions/PositionSelector"
            },
            "type": {
              "const": "image",
              "type": "string"
            }
          },
          "required": [
            "type",
            "position",
            "element",
            "page"
          ],
          "type": "object"
        }
      ]
    },
    "TextElement": {
      "additionalProperties": false,
      "properties": {
        "colour": {
          "$ref": "#/definitions/ColourSpec"
        },
        "content": {
          "type": "string"
        },
        "fontName": {
          "type": "string"
        },
        "fontSize": {
          "type": "number"
        },
        "lineHeight": {
          "type": "number"
        },
        "opacity": {
          "type": "number"
        }
      },
      "required": [
        "content"
      ],
      "type": "object"
    }
  }
}