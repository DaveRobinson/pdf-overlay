{
  "name": "pdf-overlay",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/pdf-overlay.umd.cjs",
  "module": "./dist/pdf-overlay.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/pdf-overlay.js",
      "require": "./dist/pdf-overlay.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "generate-schema": "ts-json-schema-generator --path 'src/types.ts' --type 'DocumentRules' --out schema.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ts-json-schema-generator": "^2.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
